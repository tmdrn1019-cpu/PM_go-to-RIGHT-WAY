# Copy to .env.local; use your own Seoul Open Data API key on the server only.
SEOUL_OPEN_DATA_KEY=
TAGO_SERVICE_KEY=
SGIS_SERVICE_ID=
SGIS_SECURITY_KEY=
# Optional: path to a field-verified zone feed (docs/service-data.md).
SERVICE_DATA_FILE=
# Optional: demo state file; defaults to data/demo.sqlite.
DEMO_DATA_FILE=
