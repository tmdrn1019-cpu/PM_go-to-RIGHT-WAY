{
  "name": "dynamic-pm-zones",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "geocode:towing": "node --env-file-if-exists=.env.local server/geocode-towing.mjs",
    "sync:towing": "node --env-file-if-exists=.env.local server/sync-towing.mjs",
    "dev": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local server/index.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "express": "5.3.0",
    "leaflet": "^1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  }
}
